# Database
# Percent-encode reserved characters in USER and PASSWORD (for example @ becomes %40).
DATABASE_URL=postgresql://USER:PASSWORD@db:5432/DATABASE?schema=public

# Docker Compose defaults (optional)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=meu_verdin

# Better Auth
BETTER_AUTH_SECRET=your_better_auth_secret
BETTER_AUTH_URL=http://localhost:3000 # Base URL of your app

# Google OAuth 2.0 credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# SeaweedFS (S3-compatible, server-side only)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=meu-verdin
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
